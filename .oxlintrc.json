{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "promise"],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "settings": {
    "next": {
      "rootDir": "apps/web/"
    },
    "tailwindcss": {
      "entryPoint": [
        { "files": "apps/web/**", "use": "apps/web/src/app/layout.css" },
        { "files": "**", "use": "packages/ui/src/styles/globals.css" }
      ]
    },
    "shadcn": {
      "ui": "@bypass/ui"
    }
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "error",
    "typescript/no-floating-promises": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.d.ts", "@total-typescript/ts-reset/**"]
      }
    ],
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "no-underscore-dangle": ["error", { "allow": ["_default"] }]
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["nextjs"]
    },
    {
      "files": [
        "apps/extension/**/*.{ts,tsx}",
        "apps/web/**/*.{ts,tsx}",
        "packages/shared/**/*.{ts,tsx}"
      ],
      "rules": {
        // React Compiler memoizes context values, making manual useMemo unnecessary.
        "react/jsx-no-constructed-context-values": "off"
      }
    },
    {
      "files": ["apps/*/tests/**/*.ts"],
      "rules": {
        "no-empty-pattern": "off",
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "apps/web/next-env.d.ts",
    "apps/extension/.output/**",
    "apps/extension/.wxt/**",
    "packages/ui/**"
  ]
}

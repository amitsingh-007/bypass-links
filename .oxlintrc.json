{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "promise"],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "settings": {
    "next": {
      "rootDir": "apps/web/"
    },
    "tailwindcss": {
      "entryPoint": "packages/ui/src/styles/globals.css"
    },
    "shadcn": {
      "ui": "@bypass/ui"
    }
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Avatar$",
            "allow": [
              "layout",
              "rounded-xl",
              "after:rounded-none",
              "after:border-0",
              "after:border-none",
              "ring-1",
              "ring-background"
            ]
          },
          {
            "pattern": "^AvatarImage$",
            "allow": [
              "layout",
              "rounded-none",
              "rounded-xl",
              "opacity-0",
              "opacity-100"
            ]
          },
          {
            "pattern": "^AvatarFallback$",
            "allow": ["layout", "rounded-xl"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "border-0",
              "border-success",
              "bg-success",
              "hover:border-success-hover",
              "hover:bg-success-hover",
              "bg-secondary/20",
              "backdrop-blur-sm",
              "gap-0",
              "rounded-xl",
              "p-0",
              "py-5",
              "transition-opacity",
              "hover:opacity-80"
            ]
          },
          {
            "pattern": "^ComboboxList$",
            "allow": ["layout", "py-2"]
          },
          {
            "pattern": "^ContextMenuItem$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^DialogContent$",
            "allow": ["layout", "rounded-none", "p-0"]
          },
          {
            "pattern": "^DialogFooter$",
            "allow": ["layout", "p-2"]
          },
          {
            "pattern": "^DialogHeader$",
            "allow": ["layout", "py-2"]
          },
          {
            "pattern": "^HoverCardContent$",
            "allow": ["layout", "rounded-full", "p-0.5"]
          },
          {
            "pattern": "^TooltipContent$",
            "allow": ["layout", "text-xs/relaxed"]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "error",
    "typescript/no-floating-promises": "off",
    // TODO: Fix below all rules later
    "typescript/no-unsafe-type-assertion": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "server-only",
          "**/*.d.ts",
          "@total-typescript/ts-reset/**"
        ]
      }
    ],
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "no-underscore-dangle": ["error", { "allow": ["_default"] }]
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": ["nextjs"]
    },
    {
      "files": [
        "apps/extension/**/*.{ts,tsx}",
        "apps/web/**/*.{ts,tsx}",
        "packages/shared/**/*.{ts,tsx}"
      ],
      "rules": {
        // React Compiler memoizes context values, making manual useMemo unnecessary.
        "react/jsx-no-constructed-context-values": "off"
      }
    },
    {
      "files": ["apps/*/tests/**/*.ts"],
      "rules": {
        "no-empty-pattern": "off",
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "apps/web/next-env.d.ts",
    "apps/extension/.output/**",
    "apps/extension/.wxt/**",
    "packages/ui/**"
  ]
}

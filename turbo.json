{
  "$schema": "https://turbo.build/schema.json",
  "noUpdateNotifier": true,
  "cacheMaxAge": "7d",
  "globalDependencies": [".env", ".oxlintrc.json", ".oxfmtrc.json"],
  "globalEnv": ["NEXT_PUBLIC_*", "FIREBASE_*", "GITHUB_TOKEN", "COVERAGE"],
  "globalPassThroughEnv": ["COREPACK_HOME", "ENABLE_EXPERIMENTAL_COREPACK"],
  "tasks": {
    "build": {
      "dependsOn": ["//#lint:ci", "//#typecheck"],
      "outputs": [
        ".output/**",
        ".output-coverage/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:ci": {},
    "//#typecheck": {},
    "typecheck": {}
  }
}
